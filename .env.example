# ============================================================
# AFRICA GIANTS — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================


# ── HuggingFace ─────────────────────────────────────────────
# Generate at https://huggingface.co/settings/tokens (Write permission)
HF_TOKEN=hf_your_token_here


# ── Kaggle ──────────────────────────────────────────────────
# Generate at Kaggle -> Account -> Create New API Token
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_key


# ── LLM Provider (choose ONE block below) ───────────────────
# Default: openrouter (free tier available)
# Valid values: openrouter | anthropic | ollama
LLM_PROVIDER=openrouter


# ── Option 1: OpenRouter (default, free tier available) ─────
# Free key at: https://openrouter.ai
OPENROUTER_API_KEY=sk-or-your-key-here
# Optional: override model (default: google/gemini-2.5-flash-lite — recommended)
# OPENROUTER_MODEL=google/gemini-2.5-flash-lite
# OPENROUTER_MODEL=google/gemini-flash-2.0
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free


# ── Option 2: Anthropic (paid, ~$3/M input tokens) ──────────
# Key at: https://console.anthropic.com
# Switch with: $env:LLM_PROVIDER='anthropic'
# ANTHROPIC_API_KEY=sk-ant-your-key-here


# ── Option 3: Ollama (local, free, no internet required) ────
# Install: https://ollama.ai  then: ollama pull qwen2.5:7b
# Switch with: $env:LLM_PROVIDER='ollama'
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_MODEL=llama3.2:3b


# ── Budget caps (optional overrides) ────────────────────────
# MONTHLY_BUDGET=20.0
# COST_PER_DOCUMENT_BUDGET=0.20


# ── Cerebrium deployment ─────────────────────────────────────
# Only needed for: cerebrium deploy
CEREBRIUM_API_KEY=your_cerebrium_api_key


# ── Server config ────────────────────────────────────────────
API_RELOAD_TOKEN=a_long_secure_random_string_here
PORT=8000
ENV=development
