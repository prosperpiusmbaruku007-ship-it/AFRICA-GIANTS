#!/bin/sh
# Refuse to push a red build. MECHANICAL, because remembering did not work.
#
# WHY THIS EXISTS. Three times a console operation has stood between a measurement and its
# verdict:
#   1. a PowerShell `Select-Object -First N` killed a measurement run before it wrote its
#      artifact -- twice, silently, exit 0 (R16);
#   2. a cp1252 console encoding aborted a deploy and truncated a live canary mid-pass (R16);
#   3. 2026-08-24: `pytest ... | tail -2` consumed pytest's exit status, so an `&&` chain
#      committed and PUSHED with a failing test. The suite was red and the push succeeded.
#
# The first two were written up as lessons. The third happened anyway. A rule you have to
# recall is not a fix; this is the fix.
#
# WHAT IT DOES. Runs the offline suite (pyproject addopts already deselects the live-network
# tests) and the secret scan, writes their output to files rather than piping them, and exits
# non-zero on any failure -- which aborts the push.
#
# TO INSTALL:  python scripts/install_hooks.py
# TO BYPASS:   CHIKE_SKIP_PREPUSH=1 git push     (prints a loud warning; use only when the
#              suite cannot run at all, never to push past a real failure)

set -u

if [ "${CHIKE_SKIP_PREPUSH:-0}" = "1" ]; then
    echo "!! CHIKE_SKIP_PREPUSH=1 -- pushing WITHOUT running the suite."
    echo "!! If a test is failing, this is how a red build reaches main."
    exit 0
fi

REPO="$(git rev-parse --show-toplevel)"
LOG_DIR="$REPO/.git/prepush"
mkdir -p "$LOG_DIR"

# --- what is actually being pushed --------------------------------------------------------
# THE SCAN USED TO BE VACUOUS (found 2026-08-24, one day after this hook shipped). It called
# scan_for_keys.py with no argument, which scans `git diff --cached` -- and at push time NOTHING
# IS STAGED. It printed "No files to scan" and exited 0 on every push, whatever was in it. The
# test for it asserted the hook mentions the script and branches on its status; both were true,
# and neither says the check can fail. R20, inside the gate built to enforce R20's family.
#
# git feeds pre-push lines of "<local ref> <local sha> <remote ref> <remote sha>" on stdin. The
# remote sha is all zeros for a branch the remote has never seen, in which case there is no
# range to diff and we fall back to scanning every tracked file rather than scanning nothing.
RANGE=""
while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ -z "${local_sha:-}" ] && continue
    case "$local_sha" in *[!0]*) ;; *) continue ;; esac      # deleting a ref: nothing to scan
    case "$remote_sha" in
        *[!0]*) RANGE="$remote_sha..$local_sha" ;;
        *)      RANGE="" ;;
    esac
done

echo "[pre-push] secret scan ..."
if [ -n "$RANGE" ]; then
    echo "[pre-push]   range $RANGE"
    PYTHONIOENCODING=utf-8 PYTHONUTF8=1 python "$REPO/scripts/scan_for_keys.py" \
        --range "$RANGE" > "$LOG_DIR/scan.txt" 2>&1
else
    echo "[pre-push]   no remote baseline -- scanning all tracked files"
    PYTHONIOENCODING=utf-8 PYTHONUTF8=1 python "$REPO/scripts/scan_for_keys.py" \
        --all-tracked > "$LOG_DIR/scan.txt" 2>&1
fi
SCAN=$?
tail -n 1 "$LOG_DIR/scan.txt"
if [ $SCAN -ne 0 ]; then
    echo "[pre-push] BLOCKED: scan_for_keys.py exited $SCAN"
    cat "$LOG_DIR/scan.txt"
    exit 1
fi

echo "[pre-push] offline suite (this takes ~90s) ..."
# NO PIPE. The exit status of pytest is read directly; nothing consumes it.
PYTHONIOENCODING=utf-8 PYTHONUTF8=1 python -m pytest "$REPO/tests" -q > "$LOG_DIR/pytest.txt" 2>&1
STATUS=$?
tail -n 3 "$LOG_DIR/pytest.txt"

if [ $STATUS -ne 0 ]; then
    echo ""
    echo "[pre-push] BLOCKED: pytest exited $STATUS. Full output: $LOG_DIR/pytest.txt"
    echo "[pre-push] Fix the failure, or CHIKE_SKIP_PREPUSH=1 if the suite cannot run at all."
    exit 1
fi

echo "[pre-push] OK"
exit 0
