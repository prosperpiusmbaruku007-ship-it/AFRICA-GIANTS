# Chike by Africa Giants — environment variables

# Hugging Face Hub Configuration
# Generate a token at https://huggingface.co/settings/tokens (Write permission required)
HF_TOKEN=your_huggingface_token_here

# Kaggle API Credentials
# Generate from Kaggle -> Account Settings -> Create New API Token
KAGGLE_USERNAME=prospaprospa
KAGGLE_KEY=your_kaggle_api_key_here

# Serving Configurations
API_RELOAD_TOKEN=a_long_secure_random_string_here
PORT=8000
ENV=development

# Optional Model judging API (e.g. OpenAI key for LLM-as-a-judge evaluation)
OPENAI_API_KEY=your_openai_api_key_here
